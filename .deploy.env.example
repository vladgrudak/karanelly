# Скопируйте этот файл в .deploy.env и заполните своими данными.
# .deploy.env в git не попадает — пароль остаётся только на вашем компьютере.

# Если локальный DNS отдаёт старый IP, укажите здесь IP сервера хостинга
FTP_HOST=karanelly.space
FTP_USER=u1234567
FTP_PASS=пароль_от_хостинга

# Папка сайта на FTP относительно домашней папки хостинга.
# Обычно www/karanelly.space — проверьте, что внутри лежит index.html.
REMOTE_DIR=www/karanelly.space

# 1 — FTPS (рекомендуется), 0 — обычный FTP.
FTP_TLS=1

# 1 — удалять на хостинге файлы, которых нет локально (осторожно).
DELETE=0

# 1 — проверять сертификат FTPS (может не совпадать у shared-хостинга), 0 — не проверять.
FTP_VERIFY=0

# Таймаут сетевых операций в секундах. Если рвётся на больших видео — 180 или 300.
FTP_TIMEOUT=120
